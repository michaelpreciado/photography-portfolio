{
  "name": "mario-preciado-photography",
  "version": "1.0.0",
  "description": "High-performance photography portfolio optimized for 120fps",
  "scripts": {
    "images": "node scripts/optimize-images.js",
    "minify:css": "csso css/style.css --output css/style.min.css --source-map file",
    "minify:js": "terser js/script.js -o js/script.min.js --compress --mangle --source-map \"content=inline\"",
    "minify": "npm run minify:css && npm run minify:js",
    "build": "npm run images && npm run minify",
    "lint": "node --check js/script.js && node --check js/sw-register.js && node --check sw.js && node --check scripts/optimize-images.js && node --check api/contact.js",
    "test": "npm run lint",
    "ci": "npm run lint && npm run build",
    "dev": "npm run build && python3 -m http.server 8000",
    "serve": "python3 -m http.server 8000",
    "start": "python3 -m http.server 8000"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "devDependencies": {
    "sharp": "^0.33.0",
    "glob": "^10.3.0",
    "terser": "^5.31.0",
    "csso-cli": "^4.0.2",
    "html-minifier-terser": "^7.2.0"
  },
  "keywords": [
    "photography",
    "portfolio",
    "performance",
    "120fps",
    "responsive-images"
  ],
  "author": "Mario Preciado",
  "license": "MIT"
}
